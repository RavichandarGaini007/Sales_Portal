# Development Environment (Local)
# Copy this file to .env.local and uncomment for development

# API Configuration
REACT_APP_API_URL=https://alkemcrm.com/salesapi/api/Sales/

# Application Settings
REACT_APP_ENV=development
REACT_APP_HOME_PAGE=/sales_portal/

# Analytics & Monitoring (Disabled in dev)
# REACT_APP_SENTRY_DSN=
REACT_APP_ENABLE_ANALYTICS=false

# Build Settings
REACT_APP_BUILD_VERSION=dev
GENERATE_SOURCEMAP=true

# Security (Relaxed in dev)
REACT_APP_CSP_ENABLED=false
REACT_APP_SECURE_COOKIES=false

# Local Testing (Optional)
# REACT_APP_API_URL=http://localhost:5001/api/Sales/
# REACT_APP_API_URL=https://192.168.120.64/React_Login_api/api/Sales/
